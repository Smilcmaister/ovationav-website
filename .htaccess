DirectoryIndex index.html index.php index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical public host. This assumes TLS terminates at this server.
  # If a reverse proxy terminates TLS, adapt HTTPS detection before deployment.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^ovationav\.si$ [NC]
  RewriteRule ^ https://ovationav.si%{REQUEST_URI} [R=301,L]

  # THE_REQUEST prevents redirecting internal DirectoryIndex resolution.
  RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*[/])?index\.html$ https://ovationav.si/$1 [R=301,L]
  RewriteRule ^ovation-home\.html$ / [R=301,L]
  RewriteRule ^ovation-home-en\.html$ /en/ [R=301,L]
  RewriteRule ^en$ /en/ [R=301,L]
  RewriteRule ^ovation\ bg\.mp4$ /assets/video/ovation-bg.mp4 [R=301,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|css|js|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
